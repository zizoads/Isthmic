{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "A crawled article or news item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "url": { "type": "string" },
        "platform": { "type": "string" },
        "published_at": { "type": "string", "format": "date-time" },
        "crawled_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content"]
    },
    "Trend": {
      "title": "Market Trend",
      "description": "A detected market trend or keyword.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "keyword": { "type": "string" },
        "frequency": { "type": "number" },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "opportunity_score": { "type": "number" }
      },
      "required": ["id", "keyword", "opportunity_score"]
    },
    "BrandOpportunity": {
      "title": "Brand Opportunity",
      "description": "A generated brand name or business opportunity.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "positioning": { "type": "string" },
        "gap": { "type": "string" },
        "opportunity_score": { "type": "number" }
      },
      "required": ["id", "name", "opportunity_score"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Private user profile data.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "User"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "name", "role", "createdAt"]
    }
  },
  "firestore": {
    "articles": {
      "schema": { "$ref": "Article" },
      "description": "Collection of crawled articles."
    },
    "trends": {
      "schema": { "$ref": "Trend" },
      "description": "Detected market trends."
    },
    "brand_opportunities": {
      "schema": { "$ref": "BrandOpportunity" },
      "description": "Generated brand opportunities."
    },
    "users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "Private user profile documents."
    }
  }
}
