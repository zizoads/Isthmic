{
  "entities": {
    "IntelligenceSignal": {
      "title": "Intelligence Signal",
      "description": "A signal ingested from external sources for market intelligence.",
      "type": "object",
      "properties": {
        "source": { "type": "string", "enum": ["RSS", "TELEGRAM", "API", "ADS-B"] },
        "category": { "type": "string", "enum": ["MARKET", "TECH", "LEGAL", "GEOPOLITICAL"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      },
      "required": ["source", "category", "title", "content", "priority", "timestamp"]
    },
    "Domain": {
      "title": "Domain Asset",
      "description": "A digital asset (domain name) being tracked or managed.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["available", "purchased", "negotiating", "sold", "processing", "watching"] },
        "sector": { "type": "string" },
        "justification": { "type": "string" },
        "probability": { "type": "number" },
        "integrityScore": { "type": "number" },
        "lastChecked": { "type": "string", "format": "date-time" },
        "technicalMetrics": { "type": "object" },
        "brandAssets": { "type": "object" }
      },
      "required": ["name", "price", "status"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Private user profile data.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Executive", "Analyst"] },
        "subscriptionTier": { "type": "string", "enum": ["Free", "Pro", "Sovereign"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "name", "role", "subscriptionTier", "createdAt"]
    }
  },
  "firestore": {
    "intelligence_signals": {
      "schema": { "$ref": "IntelligenceSignal" },
      "description": "Global feed of market intelligence signals."
    },
    "domains": {
      "schema": { "$ref": "Domain" },
      "description": "Global database of tracked domain assets."
    },
    "users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "Private user profile documents."
    }
  }
}
